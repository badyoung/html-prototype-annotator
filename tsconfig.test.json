{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@getpaseo/plugin": ["./node_modules/@getpaseo/plugin/dist/index.d.ts"],
      "@getpaseo/plugin/server": ["./node_modules/@getpaseo/plugin/dist/server/index.d.ts"],
      "@getpaseo/client": ["./node_modules/@getpaseo/client/dist/index.d.ts"]
    },
    "outDir": ".tmp-test",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "shared/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts"
  ]
}
