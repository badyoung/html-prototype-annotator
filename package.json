{
  "name": "paseo-html-prototype-annotator",
  "version": "1.0.2",
  "description": "Preview interactive HTML UI prototypes over Paseo without opening ports, drop visual pins or region boxes, and send structured Markdown feedback back to your agent.",
  "license": "MIT",
  "author": "badyoung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badyoung/html-prototype-annotator.git"
  },
  "homepage": "https://github.com/badyoung/html-prototype-annotator#readme",
  "bugs": {
    "url": "https://github.com/badyoung/html-prototype-annotator/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "prototype",
    "html",
    "annotation",
    "design-review",
    "ui-feedback"
  ],
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "README.md",
    "README.*.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/",
    "skills/",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .tmp-test && tsc -p tsconfig.test.json && node --test .tmp-test/tests/*.test.js && rm -rf .tmp-test",
    "verify": "npm run typecheck && npm test && npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
